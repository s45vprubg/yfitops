# yfitops Mobile — environment overrides (all optional; sensible <host> defaults).
# Copy to .env.local and edit as needed.

# WebTransport endpoint (role "mobile" connects here)
VITE_WT_URL=https://localhost:4433/wt

# Plain-HTTP backend: serves /cert-hash (dev cert pinning) and /auth/spotify (OAuth)
VITE_HTTP_URL=http://localhost:8777

# DEV-ONLY cleartext WebSocket fallback for phones on a plain-HTTP LAN origin
# where WebTransport is unavailable. Only ever used when import.meta.env.DEV
# is true (gated at the call site in src/lib/useGame.ts) — a production build
# never reads this var, and the server likewise refuses to register /ws when
# YFI_ENV=prod. Do NOT rely on this in production.
VITE_WS_URL=ws://localhost:8777/ws
