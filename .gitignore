# work / scratch area — never committed
scripts/_work/

# scratch / probe output — never committed
temp/

# QA sweep artifacts — per-agent findings and validation verdicts, machine
# generated and only meaningful next to the run that produced them. Kept on disk
# (qa/HANDOFF.md's resume checklist reads them) but not committed. The narrative
# that outlives a sweep lives in qa/HANDOFF.md, which IS tracked.
qa/findings*/
qa/validation*/

# Go
server/bin/
*.test
*.out

# Node
node_modules/
web/*/dist/
.vite/

# env / secrets
.env
.env.local
*.pem
certs/

# os
.DS_Store

# vendored legacy reference (banovik/NameThatSpotify) — kept locally, not committed
reference/legacy-core/

# TS incremental build cache
*.tsbuildinfo

# local AI tool config (holds a .env with credentials — machine-local only)
.gemini/
